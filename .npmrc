# Supply-chain posture for a single-developer, side-loaded app.
#
# The threat being defended against is a compromised or typosquatted release
# landing in a routine `npm install` and executing arbitrary code on this
# machine — which is the ordinary shape of an npm supply-chain attack.

# Write exact versions, never a caret or tilde. A range is a standing agreement
# to run code nobody has reviewed yet; the lockfile alone is not enough because
# `npm update` and a fresh resolve can both quietly move a range forward.
save-exact=true

# Do not run preinstall/install/postinstall scripts from ANY package. This is
# the single highest-value setting here: install scripts are the usual delivery
# mechanism, and they run before the code is ever imported.
#
# Two dev dependencies genuinely need theirs (better-sqlite3 compiles a native
# binding, esbuild links a platform binary). Build them deliberately with:
#     npm run rebuild:native
# Nothing the app itself ships at runtime needs an install script.
ignore-scripts=true

# Refuse anything published in the last 24 hours. Malicious releases are almost
# always pulled within hours, so simply waiting removes most of the exposure.
# Requires npm >= 11.6.1 — on 11.6.0 npm warns "Unknown project config" and
# ignores it, which is harmless but means the protection is NOT yet active.
minimumReleaseAge=1440

# expo-router declares react-dom as an optional peer for its web target, which
# this app does not use. Without this the install cannot resolve at all.
legacy-peer-deps=true
