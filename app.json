{
  "expo": {
    "name": "Chalk",
    "slug": "chalk",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chalk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12100E"
    },
    "android": {
      "package": "com.andrewcampkin.chalk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12100E"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95c4dab4-9e82-465c-a04a-33c0aab89a51"
      }
    },
    "owner": "andrewcampkin"
  }
}
