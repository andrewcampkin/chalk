{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "db/**/*.ts",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "tests/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
